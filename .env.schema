# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# The variables of coro.settings.ServerSettings. All optional; the defaults are the class's.
#
# @defaultRequired=false @defaultSensitive=false
# ----------

# Bind host.
CORO_HOST=

# Bind port.
CORO_PORT=

# Allowed CORS origins.
CORO_CORS_ORIGINS=

# Configured Transcription Pipeline selector.
CORO_PIPELINE=

# ASR Backend Provider selector.
CORO_BACKEND_ASR=

# ASR Model Selection.
CORO_MODEL_ASR=

# Faster Whisper device selection.
CORO_ASR_DEVICE=

# Faster Whisper compute type selection.
CORO_ASR_COMPUTE_TYPE=

# Encoder quantization selector.
CORO_ASR_QUANTIZATION=

# onnx-canary-split decoder_step.onnx quantization selector.
CORO_ASR_DECODER_QUANTIZATION=

# Language used when a request gives no language hint and no detection is available.
CORO_ASR_FALLBACK_LANGUAGE=

# Enable Silero VAD speech segmentation for the onnx-asr backend.
CORO_ASR_ONNX_VAD=

# Optional Silero VAD speech probability threshold for the onnx-asr backend.
CORO_ASR_ONNX_VAD_THRESHOLD=

# Diarization Backend Provider selector.
CORO_BACKEND_DIARIZATION=

# Diarization Model Selection.
CORO_MODEL_DIARIZATION=

# Diarization device selection.
CORO_DIARIZATION_DEVICE=

# HuggingFace access token for gated diarization models.
# @sensitive
CORO_HF_TOKEN=
# The same token under the Hugging Face libraries' name.
# @sensitive
HF_TOKEN=

# Directory for the streaming pipeline's per-request transcript spill store, and for the audio
# backlog of live WebSocket streams.
CORO_TRANSCRIPT_SPILL_DIR=

# Log level.
CORO_LOG_LEVEL=

# Diarization Latency Selection tier for streaming Sortformer.
CORO_DIARIZATION_LATENCY=

# Diarization Post-Processing Configuration for NeMo Sortformer.
CORO_DIARIZATION_POSTPROCESSING=

# Speaker-Count Post-Processing Gate ceiling.
CORO_DIARIZATION_POSTPROCESSING_MAX_SPEAKERS=

# Reuse previously-computed ASR window results from disk, so re-running audio that has already
# been transcribed skips the model entirely.
CORO_ASR_CACHE=

# Directory for the ASR window cache.
CORO_ASR_CACHE_DIR=

# Size cap for the ASR window cache, in megabytes.
CORO_ASR_CACHE_MAX_MB=

# Lifetime of an ASR window cache entry, in days, applied lazily on lookup.
CORO_ASR_CACHE_TTL_DAYS=

# Server Warmup runs the Configured Transcription Pipeline against the Warmup Audio Asset at
# startup.
CORO_WARMUP=

# Maximum ASR inference calls allowed to run at once. 0 auto-sizes from the host core count so
# total backend thread demand stays near it.
CORO_ASR_MAX_CONCURRENCY=

# Maximum ASR inference calls allowed to wait for a concurrency permit.
CORO_ASR_MAX_QUEUE_DEPTH=

# Transcription requests one client IP may start per minute, as a burst that refills evenly.
CORO_RATE_LIMIT_REQUESTS_PER_MINUTE=

# Minutes of audio one client IP may submit per hour, refilling evenly.
CORO_RATE_LIMIT_AUDIO_MINUTES_PER_HOUR=

# TLS certificate file path.
CORO_SSL_CERTFILE=

# TLS private key file path.
CORO_SSL_KEYFILE=

# Host variables coro reads (coro/settings/host.py).
# User cache root for the ASR window cache and the transcript spill fallback.
XDG_CACHE_HOME=
# GPUs visible to the process; part of the ASR cache fingerprint.
CUDA_VISIBLE_DEVICES=

# coro-bench flag defaults (coro/bench/settings.py); a flag wins over each.
# Output directory of a benchmark run.
OUT_DIR=
# Seconds between resource samples.
SAMPLE_INTERVAL=
# Root PID of an attached server to sample.
SERVER_PID=
# Command-line substring that finds an attached server when SERVER_PID is unset.
SERVER_MATCH=
